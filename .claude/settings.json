{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make validate)",
      "Bash(make summarize)",
      "Bash(make compare)",
      "Bash(make figures)",
      "Bash(python -m benchkit:*)",
      "Bash(python -m pytest:*)",
      "Bash(flutter analyze:*)",
      "Bash(adb devices)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Edit(data/raw/**)",
      "Write(data/raw/**)",
      "Read(.env)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)"
    ]
  }
}
